---
const now = new Date();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jeremy Xu</title>
  </head>

  <body>
    <main class="container">
      <section class="hero">
        <p class="tag">Personal Website</p>
        <h1>Hi, I'm Jeremy Xu.</h1>
        <p class="intro">
          Computer Science student interested in backend systems, databases,
          data infrastructure, and AI applications.
        </p>

        <div class="links">
          <a href="/blog">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/now">Now</a>
        </div>
      </section>

      <section class="card">
        <h2>Current Time</h2>
        <p id="clock">Loading...</p>
      </section>

      <section class="card">
        <h2>Currently</h2>
        <ul>
          <li>Learning Java backend development</li>
          <li>Preparing for postgraduate study abroad</li>
          <li>Building my personal website</li>
          <li>Writing notes about programming and university life</li>
        </ul>
      </section>
    </main>

    <script>
      function updateClock() {
        const el = document.getElementById("clock");
        const now = new Date();
        el.textContent = now.toLocaleString("en-US", {
          hour12: false,
          timeZoneName: "short",
        });
      }

      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top left, #f5d6ff 0, transparent 30%),
      radial-gradient(circle at bottom right, #d7ecff 0, transparent 35%),
      #fafafa;
    color: #18181b;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 96px 24px;
  }

  .hero {
    margin-bottom: 48px;
  }

  .tag {
    color: #7c3aed;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
    margin: 16px 0;
  }

  .intro {
    max-width: 640px;
    font-size: 1.2rem;
    line-height: 1.8;
    color: #52525b;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .links a {
    text-decoration: none;
    color: white;
    background: #18181b;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 600;
  }

  .card {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 24px;
    padding: 28px;
    margin: 20px 0;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(16px);
  }

  .card h2 {
    margin-top: 0;
  }

  li {
    margin: 8px 0;
  }
</style>