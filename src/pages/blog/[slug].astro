---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Jeremy Xu`} description={post.data.description}>
  <article class="article">
    <a class="back" href="/blog">← Back to blog</a>

    <header>
      <p class="date">{post.data.date.toLocaleDateString("en-US")}</p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>

      <div class="tags">
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 780px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    color: #7c3aed;
    text-decoration: none;
    font-weight: 800;
  }

  header {
    margin-bottom: 42px;
  }

  .date {
    margin: 0 0 12px;
    color: #7c3aed;
    font-size: 0.92rem;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .description {
    margin: 20px 0 0;
    color: #71717a;
    font-size: 1.12rem;
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tags span {
    border-radius: 999px;
    padding: 6px 10px;
    color: #52525b;
    font-size: 0.84rem;
    background: rgba(24, 24, 27, 0.06);
  }

  .content {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 28px;
    padding: 34px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(16px);
  }

  .content :global(p) {
    color: #3f3f46;
    line-height: 1.9;
    font-size: 1.05rem;
  }

  .content :global(h2) {
    margin-top: 2rem;
    font-size: 1.6rem;
  }

  .content :global(a) {
    color: #7c3aed;
    font-weight: 700;
  }

  .content :global(code) {
    border-radius: 8px;
    padding: 2px 6px;
    background: rgba(24, 24, 27, 0.08);
  }

  .content :global(pre) {
    overflow-x: auto;
    border-radius: 18px;
    padding: 18px;
    background: #18181b;
    color: #fafafa;
  }

  @media (max-width: 720px) {
    .content {
      padding: 24px;
    }
  }
</style>