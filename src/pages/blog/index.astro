---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog | Jeremy Xu" description="Blog posts by Jeremy Xu.">
  <section>
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Notes from the long road.</h1>
    <p class="page-description">
      Programming notes, university life, project logs, and thoughts I want to
      keep somewhere more permanent than a chat window.
    </p>
  </section>

  <section class="posts">
    {
      posts.map((post) => (
        <a class="post" href={`/blog/${post.id}/`}>
          <div>
            <p class="date">{post.data.date.toLocaleDateString("en-US")}</p>
            <h2>{post.data.title}</h2>
            <p class="description">{post.data.description}</p>
          </div>

          <div class="tags">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .posts {
    display: grid;
    gap: 18px;
    margin-top: 48px;
  }

  .post {
    display: block;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 26px;
    padding: 26px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(16px);
  }

  .date {
    margin: 0 0 8px;
    color: #7c3aed;
    font-size: 0.9rem;
    font-weight: 800;
  }

  h2 {
    margin: 0 0 10px;
  }

  .description {
    margin: 0;
    color: #71717a;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .tags span {
    border-radius: 999px;
    padding: 6px 10px;
    color: #52525b;
    font-size: 0.84rem;
    background: rgba(24, 24, 27, 0.06);
  }
</style>