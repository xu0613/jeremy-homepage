---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Jeremy Xu" description="About Jeremy Xu.">
  <section>
    <p class="eyebrow">About</p>
    <h1 class="page-title">A small map of who I am.</h1>
    <p class="page-description">
      I'm Jeremy Xu, a computer science student who enjoys programming, reading
      online novels, badminton, and building tools that make life slightly more
      interesting.
    </p>
  </section>

  <section class="grid grid-2 about-grid">
    <div class="card">
      <h2>What I care about</h2>
      <p>
        I am especially interested in backend systems, databases, data
        infrastructure, and AI applications. I like things that are practical,
        reliable, and quietly powerful.
      </p>
    </div>

    <div class="card">
      <h2>What I'm learning</h2>
      <p>
        Java backend development, SQL, Linux, Git, computer networks, operating
        systems, and the kind of engineering habits that make projects survive
        longer than one weekend.
      </p>
    </div>

    <div class="card">
      <h2>Why this site exists</h2>
      <p>
        This website is my personal archive: notes, projects, essays, fragments
        of thinking, and small technical experiments. A public notebook, but
        with better lighting.
      </p>
    </div>

    <div class="card">
      <h2>Elsewhere</h2>
      <p>
        You can find my code and projects on GitHub. More links will be added
        here when this little site grows up a bit.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    margin-top: 48px;
  }

  h2 {
    margin-top: 0;
  }

  p {
    color: #71717a;
    line-height: 1.8;
  }
</style>