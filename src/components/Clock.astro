<div class="clock-card">
  <div>
    <p class="label">Local Time</p>
    <p id="clock" class="time">Loading...</p>
  </div>
  <p class="hint">A tiny reminder that life is moving. Use it kindly.</p>
</div>

<script>
  function updateClock() {
    const clock = document.getElementById("clock");
    if (!clock) return;

    const now = new Date();
    clock.textContent = now.toLocaleString("en-US", {
      hour12: false,
      weekday: "short",
      year: "numeric",
      month: "short",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      timeZoneName: "short",
    });
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .clock-card {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .label {
    margin: 0 0 8px;
    color: #7c3aed;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .time {
    margin: 0;
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hint {
    max-width: 260px;
    margin: 0;
    color: #71717a;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .clock-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>